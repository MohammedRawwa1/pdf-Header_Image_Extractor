## Example environment variables for the bot
# Copy this file to `.env` (or set the same variables in your hosting
# dashboard, e.g. Railway) and fill in your values.
#
# Booleans accept: 1 / true / yes  (and 0 / false / no for off).

# ── Required ────────────────────────────────────────────────────────────────
BOT_TOKEN=

# ── Webhook / networking ─────────────────────────────────────────────────────
# Public URL for the webhook. If left empty, it is auto-derived from Railway's
# RAILWAY_PUBLIC_DOMAIN at startup.
WEBHOOK_URL=
HOST=0.0.0.0
PORT=8000
# Use long-polling instead of webhooks (local dev).
USE_POLLING=false
# Logging level (INFO, DEBUG, WARNING, ERROR).
LOG_LEVEL=INFO

# ── Owner & admins (security) ────────────────────────────────────────────────
# Your Telegram user ID — full control over /s webhook commands
# (falls back to ADMIN_USERS when unset).
OWNER_ID=
# Comma-separated Telegram user IDs who are allowed to run admin commands.
ADMIN_USERS=
# HTTP admin secret used to protect REST admin endpoints.
ADMIN_SECRET=
# Webhook secret token (X-Telegram-Bot-Api-Secret-Token); auto-generated if unset.
WEBHOOK_SECRET=
# Comma-separated Telegram user IDs allowed to use the bot. Empty = open to everyone.
ALLOWED_USER_IDS=
# Single Telegram user ID allowed to run admin commands + receive health alerts.
ADMIN_USER_ID=

# ── Logging & integrations ──────────────────────────────────────────────────
LOG_CHANNEL=
SENTRY_DSN=

# ── Background queue (required for buttons/jobs) ─────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Run the RQ worker inside the web process instead of a separate service.
RUN_WORKER_IN_PROC=false
# Long-polling interval in seconds.
LONGPOLL_INTERVAL=1

# ── Limits ───────────────────────────────────────────────────────────────────
# Max upload size in bytes (0 = unlimited).
MAX_FILE_SIZE=0
# Telegram Bot API UPLOAD max (sendDocument) in MB.
BOT_API_MAX_MB=50
# Telegram Bot API DOWNLOAD max (getFile) in MB — files above this route
# through the userbot / BigFilePipeline.
BOT_API_DOWNLOAD_MAX_MB=20
# Optional custom temp directory for downloads (defaults to system temp).
TMP_DIR=

# ── PDF compression ─────────────────────────────────────────────────────────
# Ghostscript quality preset used by the 🗜 Compress PDF button.
PDF_COMPRESS_QUALITY=/ebook

# ── Book conversion (Calibre) ────────────────────────────────────────────────
# Master switch for the e-book conversion feature (Convert button + jobs).
ENABLE_BOOK_CONVERSION=true
# Comma-separated extensions the bot accepts for book conversion. When empty a
# curated default set is used: pdf, epub, mobi, azw3, azw, fb2, lit, prc, pdb,
# docx, rtf, txt, html, odt, snb, tcr.
ALLOWED_FORMATS=
# Per-conversion timeout (seconds) for Calibre's ebook-convert.
BOOK_CONVERT_TIMEOUT_SECONDS=600
# How long a pending Convert-button choice stays valid (seconds).
BOOK_ASK_TTL_SECONDS=600

# ── WeasyPrint EPUB→PDF fast path (utils/weasyprint_converter.py) ────────────
# Master switch for the fast path (falls back to Calibre when disabled).
EPUB_FAST_CONVERT_ENABLED=true
# Page geometry applied on top of the EPUB's own CSS. Anything WeasyPrint
# accepts works: "A4", "Letter", "6in 9in", "210mm 297mm", "A4 landscape".
# The EPUB's own @page rules are overridden so oversized images can never
# determine a dimension larger than this printable page.
EPUB_PAGE_SIZE=A4
EPUB_PAGE_MARGIN=15mm
# Raster images wider than this (px) are re-encoded at ~2x the printable page
# width before rendering (smaller PDFs, faster Bot API uploads).
EPUB_IMAGE_DOWNSAMPLE_MIN_WIDTH_PX=3000
EPUB_IMAGE_JPEG_QUALITY=85
# Cap (seconds) on the Calibre fallback when merged content came out blank.
EPUB_EMPTY_MERGE_FALLBACK_SECONDS=240
# Post-render shrink: when the rendered PDF exceeds this threshold (MB),
# embedded JPEG/PNG images are re-encoded to JPEG at a lower quality. 0 = use
# 60% of BOT_API_MAX_MB (30MB at the default 50MB upload limit).
PDF_RECOMPRESS_MIN_MB=0
PDF_RECOMPRESS_JPEG_QUALITY=70
# Only keep the re-encoded PDF when it shrank by at least this much
# (percentage and absolute bytes).
PDF_RECOMPRESS_MIN_GAIN_PCT=5
PDF_RECOMPRESS_MIN_GAIN_BYTES=100000

# ── OCR (Tesseract) ──────────────────────────────────────────────────────────
# Master switch for the 🔎 OCR button (searchable PDF + plain-text extraction).
ENABLE_OCR=true
# Tesseract language code(s), e.g. "eng" or "eng+fra" (packs must be installed
# in the image: tesseract-ocr-<lang>).
OCR_LANG=eng
# Per-page OCR timeout (seconds) applied to each Tesseract invocation.
OCR_TIMEOUT_SECONDS=600
# DPI used to rasterize PDF pages before OCR (200 is a good balance).
OCR_DPI=200

# ── Storage backend ──────────────────────────────────────────────────────────
# 'local', 's3', or 'r2'.
STORAGE_BACKEND=local
STORAGE_PATH=./storage
INPUT_PATH=
OUTPUT_PATH=
TEMP_PATH=
THUMBNAIL_PATH=

# Optional S3/R2 fallback for large files
ENABLE_S3_FALLBACK=false
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGNED_EXPIRY=3600
S3_SIGNATURE_VERSION=s3v4
S3_USE_SSL=1
PRESIGN_EXPIRES=3600

# ── Userbot (for files >20MB) ────────────────────────────────────────────────
# API_ID / API_HASH from my.telegram.org. Sessions are per-user.
API_ID=
API_HASH=
# Pyrogram session string (preferred).
PYROGRAM_SESSION=
# Telethon string session.
TELETHON_SESSION=
# Force-enable/disable the userbot fallback (defaults to enabled when
# API credentials are present).
ENABLE_USERBOT=
# Relay chat for userbot big-file transfers (optional).
RELAY_CHAT_ID=
# Optional alternate credential names (read as fallbacks to API_ID/API_HASH).
USERBOT_API_ID=
USERBOT_API_HASH=
# Telethon client tuning (utils/telethon_session.py)
TELETHON_TIMEOUT=120
TELETHON_REQUEST_RETRIES=10
TELETHON_CONNECTION_RETRIES=5
TELETHON_RETRY_DELAY=3
TELETHON_PROXY=
# Userbot download/upload tuning (utils/userbot_downloader.py, userbot_uploader.py)
TELETHON_MAX_RETRY_ATTEMPTS=20
TELETHON_DOWNLOAD_TIMEOUT=600
TELETHON_DOWNLOAD_PART_SIZE_KB=512
TELETHON_UPLOAD_PART_SIZE_KB=512
PYROGRAM_MAX_RETRY_ATTEMPTS=6
PYROGRAM_DOWNLOAD_TIMEOUT=600
# Pyrogram client tuning (utils/telethon_session.py)
PYROGRAM_MAX_RETRIES=10
PYROGRAM_SLEEP_THRESHOLD=30

# ── Big-file pipeline / cache (utils/) ───────────────────────────────────────
# In-memory ceiling (MB) before the big-file pipeline spills to disk.
BIGFILE_IN_MEMORY_MAX_MB=200
# Cache TTL for big-file blobs (seconds).
BIGFILE_CACHE_TTL=3600
# How long RQ job metadata is retained (seconds).
JOB_METADATA_TTL=86400

# ── Cleanup sweeper (utils/cleanup.py) ───────────────────────────────────────
# Interval between cleanup sweeps (seconds).
CLEANUP_INTERVAL=3600
# Max age of temp files (seconds) before deletion.
CLEANUP_MAX_TEMP_AGE=3600
# Max age of processed input files (seconds).
CLEANUP_MAX_FILE_AGE=86400
# TTL for stale S3 objects (seconds).
CLEANUP_S3_TTL=86400
# TTL for old I/O records (seconds).
CLEANUP_IO_TTL=604800

# ── S3 operation retries (utils/storage.py) ───────────────────────────────────
S3_OP_RETRIES=3
S3_OP_BACKOFF_BASE=1
S3_OP_BACKOFF_MAX=60
S3_FORCE_PATH_STYLE=
AWS_SESSION_TOKEN=

# ── Session / monitoring (optional) ─────────────────────────────────────────
# Seconds between userbot session health checks.
SESSION_HEALTHCHECK_INTERVAL=3600
# Keep-alive heartbeat: URL to ping (defaults to WEBHOOK_URL), interval
# (60–840s), and a switch to disable it entirely.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL=600
KEEP_ALIVE_DISABLED=false
# Progress-message watchdog: check interval + how old a task must be before
# its transient progress message is auto-removed.
PROGRESS_WATCHDOG_INTERVAL_SECONDS=300
PROGRESS_WATCHDOG_STALE_SECONDS=1800

# ── Mongo (optional, for Telethon session storage) ──────────────────────────
# Any of MONGO_URI / MONGODB_URL / MONGODB_URI / MONGO_URL works.
MONGO_URI=
# Scripts-only (scripts/telethon_ingest.py, scripts/create_pyrogram_session.py):
# ENABLE_TELETHON_INGEST, TELETHON_MONGO_BRIDGE, TELETHON_SESSION_NAME,
# API_SESSION, API_SESSION_NAME, PYROGRAM_SESSION_NAME, TELEGRAM_APP_ID,
# TELEGRAM_API_HASH

# ── Docker build args (set at build time, not runtime) ──────────────────────
# The Dockerfile installs Tesseract OCR and Calibre by default; set these to
# "0" in the build environment to skip them on space-constrained builds.
# INSTALL_OCR=1
# INSTALL_CALIBRE=1
