## Example environment variables for the bot
# Required
BOT_TOKEN=8627359695:AAHp4xlF_u1LshnfipU24jAoHyq46hCp_oM

# Optional - webhook / networking
WEBHOOK_URL=
HOST=0.0.0.0
PORT=8000
USE_POLLING=false

# Admins & security
# Comma-separated Telegram user IDs who are allowed to run admin commands
ADMIN_USERS=
# HTTP admin secret used to protect REST admin endpoints
ADMIN_SECRET=

# Logging & integrations
LOG_CHANNEL=
SENTRY_DSN=

# Background queue (optional)
REDIS_URL=redis://localhost:6379/0

# Limits
# Max upload size in bytes (default 50MB)
MAX_FILE_SIZE=52428800
# Optional custom temp directory for downloads (defaults to system temp)
TMP_DIR=
