# ============================================================
# PDF Header / Cover Image Extractor Bot
# ============================================================
# Copy this file to .env and fill in the values.

# -- Core (Required) -------------------------------------------
BOT_TOKEN=
# Public URL for the webhook (auto-derived from RAILWAY_PUBLIC_DOMAIN on Railway if left empty)
WEBHOOK_URL=

# -- Server ----------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Webhook CSRF secret (X-Telegram-Bot-Api-Secret-Token). Auto-generated if empty.
WEBHOOK_SECRET=
# Railway public domain used to auto-derive WEBHOOK_URL when not set.
RAILWAY_PUBLIC_DOMAIN=

# -- Bot Mode --------------------------------------------------
USE_POLLING=false

# -- Owner & Admin Security ------------------------------------
OWNER_ID=
ADMIN_USERS=
ADMIN_SECRET=

# -- Access Control List (multi-user) --------------------------
# Telegram user ids allowed to use the bot (comma-separated).
# Empty = open to everyone (default, so users can try the bot).
ALLOWED_USER_IDS=
# Single admin user id allowed to run /admin add|remove|list and receive alerts.
ADMIN_USER_ID=

# -- Logging & Monitoring --------------------------------------
LOG_CHANNEL=
SENTRY_DSN=

# -- Background Queue ------------------------------------------
REDIS_URL=
RUN_WORKER_IN_PROC=false

# -- File Limits -----------------------------------------------
MAX_FILE_SIZE=52428800
BOT_API_MAX_MB=50

# -- Storage Paths ---------------------------------------------
STORAGE_BACKEND=local
STORAGE_PATH=./storage
INPUT_PATH=./storage/input
OUTPUT_PATH=./storage/output
TEMP_PATH=./storage/temp
THUMBNAIL_PATH=./storage/thumbnails
TMP_DIR=

# -- PDF Processing --------------------------------------------
PDF_COMPRESS_QUALITY=/ebook

# -- S3 / R2 Storage (optional) --------------------------------
ENABLE_S3_FALLBACK=false
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PRESIGNED_EXPIRY=3600
PRESIGN_EXPIRES=3600

# -- Userbot / Big Files (>50MB) --------------------------------
API_ID=
# Alternative credential env names honored by the userbot gate + login flows.
USERBOT_API_ID=
API_HASH=
PYROGRAM_SESSION=
TELETHON_SESSION=
RELAY_CHAT_ID=
# Force userbot on/off. Default: enabled when API_ID/API_HASH are set.
ENABLE_USERBOT=

# -- Telethon Ingest Service -----------------------------------
ENABLE_TELETHON_INGEST=false
TELETHON_LISTEN_INCOMING=false
TELETHON_SESSION_DIR=./storage/temp_sessions
TELETHON_CLEAN_SESSION=false
TELETHON_DEBUG_PORT=8081
TELETHON_DEBUG_TOKEN=
TELETHON_LOG_PATH=/tmp/telethon_ingest.log
TELETHON_MONGO_BRIDGE=false

# -- MongoDB (optional) ----------------------------------------
MONGO_URI=
MONGODB_NAME=pdf_header_bot

# -- Keep-Alive (free-tier spin-down prevention; auto-detects Railway domain) ------------------
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL=600
KEEP_ALIVE_DISABLED=false

# -- Webhook Monitor -------------------------------------------
WEBHOOK_LOCAL_TIMEOUT=3
WEBHOOK_EXTERNAL_TIMEOUT=10
